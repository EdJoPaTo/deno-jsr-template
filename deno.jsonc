{
	"name": "@edjopato/deno-jsr-template",
	"version": "0.0.0",
	"license": "MIT",
	"exports": "./source/mod.ts",
	"lock": false,
	"nodeModulesDir": "none",
	// https://deno.land/manual/advanced/typescript/configuration
	// https://www.typescriptlang.org/tsconfig/
	"compilerOptions": {
		"erasableSyntaxOnly": true,
		"noImplicitReturns": true,
		"noPropertyAccessFromIndexSignature": true,
		"noUncheckedIndexedAccess": true
	},
	"exclude": [
		"./coverage/",
		"./dist/",
		"./docs/",
		"./node_modules/"
	],
	"fmt": {
		"useTabs": true
	},
	"imports": {
	},
	"lint": {
		"rules": {
			// https://lint.deno.land/?all=on
			"tags": [
				"jsr",
				"recommended",
				"workspace"
			],
			"include": [
				"camelcase",
				"default-param-last",
				"eqeqeq",
				"explicit-module-boundary-types",
				"no-await-in-loop",
				"no-eval",
				"no-inferrable-types",
				"no-node-globals",
				"no-non-null-asserted-optional-chain",
				"no-non-null-assertion",
				"no-process-global",
				"no-self-compare",
				"no-sparse-arrays",
				"no-sync-fn-in-async-fn",
				"no-undef",
				"no-useless-rename",
				"prefer-ascii",
				"single-var-declarator",
				"triple-slash-reference"
			]
		}
	},
	"publish": {
		"include": [
			"deno.json*",
			"LICENSE*",
			"README*",
			"source"
		],
		"exclude": [
			"**/*.test.*",
			"**/test.*"
		]
	},
	"tasks": {
		"doc": "deno doc --html --name=deno-jsr-template source/mod.ts"
	}
}
